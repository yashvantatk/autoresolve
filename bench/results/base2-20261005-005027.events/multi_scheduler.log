Fix ZeroDivisionError in average_wait when waits list is empty.
--- a/scheduler.py
+++ b/scheduler.py
@@ -6,4 +6,6 @@
 def average_wait(waits):
     """Return the mean waiting time, or 0.0 when nobody waited."""
+    if not waits:
+        return 0.0
     return sum(waits) / len(waits)
 
